        <sum> <product> <value> 2.5844175e-07 </value> <pow> <property> fcs/iris/omega[0] </property> <value> 2 </value> </pow> </product> <product> <value> 2.5844175e-07 </value> <pow> <property> fcs/iris/omega[1] </property> <value> 2 </value> </pow> </product> <product> <value> -2.5844175e-07 </value> <pow> <property> fcs/iris/omega[2] </property> <value> 2 </value> </pow> </product> <product> <value> -2.5844175e-07 </value> <pow> <property> fcs/iris/omega[3] </property> <value> 2 </value> </pow> </product> </sum>
      </function>
    </axis>
    <function name="aero/iris/rotor-speed-sum"> <sum> <property> fcs/iris/omega[0] </property> <property> fcs/iris/omega[1] </property> <property> fcs/iris/omega[2] </property> <property> fcs/iris/omega[3] </property> </sum> </function>
    <axis name="X"> <function name="aero/force/iris-rotor-drag-x"> <product> <value> -1.1991308e-05 </value> <property> aero/iris/rotor-speed-sum </property> <property> velocities/u-aero-fps </property> </product> </function> </axis>
    <axis name="Y"> <function name="aero/force/iris-rotor-drag-y"> <product> <value> -1.1991308e-05 </value> <property> aero/iris/rotor-speed-sum </property> <property> velocities/v-aero-fps </property> </product> </function> </axis>
