    <property value="1">fsim/applicability/drag_devices</property>
    <property value="0">fsim/applicability/flaps</property>
    <property value="1">fsim/applicability/ground_contact</property>
    <property value="4">fsim/applicability/releasable_stores</property>
    <property value="0">fsim/applicability/retractable_gear</property>
    <property value="1">fsim/applicability/vertical_flight</property>
    <channel name="pilot">
      <!-- the controls in inches: stick and pedals from the centre, + forward, + right, + right
           pedal; the collective from the bottom -->
      <pure_gain name="fcs/uh60/long-in"> <input> fcs/elevator-cmd-norm </input> <gain> 5 </gain> </pure_gain>
      <pure_gain name="fcs/uh60/lat-in"> <input> fcs/aileron-cmd-norm </input> <gain> 5 </gain> </pure_gain>
      <pure_gain name="fcs/uh60/pedal-in"> <input> fcs/rudder-cmd-norm </input> <gain> -3.5 </gain> </pure_gain>
      <pure_gain name="fcs/uh60/coll-in"> <input> fcs/throttle-cmd-norm[0] </input> <gain> 10 </gain>
        <clipto> <min> 0 </min> <max> 10 </max> </clipto> </pure_gain>
    </channel>
    <channel name="pitch bias actuator">
      <!-- TM-85890 figure 11: pitch attitude, pitch rate and airspeed (80 to 180 kt) to an actuator
           of 15 % authority, 3 %/s, added to the longitudinal cyclic (0.1 in per % aft) -->
      <fcs_function name="fcs/uh60/q-deg"> <function> <todegrees> <property> velocities/q-rad_sec </property> </todegrees> </function> </fcs_function>
      <lag_filter name="fcs/uh60/airspeed-kt"> <input> fcs/uh60/u-kt </input> <c1> 2.5126 </c1> </lag_filter>
      <fcs_function name="fcs/uh60/pba-cmd-pct">
        <function> <sum>
          <product> <value> -0.375 </value> <max> <value> -20 </value> <min> <value> 20 </value> <property> attitude/theta-deg </property> </min> </max> </product>
          <product> <value> -0.13125 </value> <max> <value> -34.5 </value> <min> <value> 34.5 </value> <property> fcs/uh60/q-deg </property> </min> </max> </product>
          <product> <value> 0.0525 </value> <max> <value> 0 </value> <min> <value> 100 </value> <difference> <property> fcs/uh60/airspeed-kt </property> <value> 80 </value> </difference> </min> </max> </product>
          <value> -4.9 </value>
        </sum> </function>
      </fcs_function>
      <actuator name="fcs/uh60/pba-pct"> <input> fcs/uh60/pba-cmd-pct </input>
        <lag> 10 </lag> <rate_limit> 3 </rate_limit> <clipto> <min> -15 </min> <max> 15 </max> </clipto> </actuator>
      <pure_gain name="fcs/uh60/pba-in"> <input> fcs/uh60/pba-pct </input> <gain> -0.1000122 </gain> </pure_gain>
    </channel>
    <channel name="stabilator">
      <!-- TM-85890 figure 10: the incidence (deg, + trailing edge down) from pitch rate, lateral
           acceleration, airspeed and collective, through the servo, a rate and a position limit -->
      <second_order_filter name="fcs/uh60/ay-sensed"> <input> accelerations/a-pilot-y-ft_sec2 </input>
        <c1> 0 </c1> <c2> 0 </c2> <c3> 1 </c3> <c4> 0.0254 </c4> <c5> 0.233 </c5> <c6> 1 </c6> </second_order_filter>
      <fcs_function name="fcs/uh60/coll-pct"> <function> <product> <property> fcs/uh60/coll-in </property> <value> 10 </value> </product> </function> </fcs_function>
      <fcs_function name="fcs/uh60/stab-cmd-deg">
        <function> <sum>
          <value> 42 </value>
          <product> <value> 0.16 </value> <property> fcs/uh60/q-deg </property> </product>
          <product> <value> -0.0433 </value> <property> fcs/uh60/ay-sensed </property>
            <max> <value> 0 </value> <min> <value> 30 </value> <difference> <property> fcs/uh60/airspeed-kt </property> <value> 30 </value> </difference> </min> </max> </product>
          <product> <value> -1 </value>
            <max> <value> 0 </value> <min> <value> 50 </value> <difference> <property> fcs/uh60/airspeed-kt </property> <value> 30 </value> </difference> </min> </max>
            <sum> <value> 0.67 </value>
              <product> <value> 0.003286 </value> <max> <value> 0 </value> <min> <value> 50 </value> <difference> <value> 50 </value> <property> fcs/uh60/coll-pct </property> </difference> </min> </max> </product>
              <product> <value> 0.003286 </value> <max> <value> 0 </value> <min> <value> 20 </value> <difference> <value> 70 </value> <property> fcs/uh60/coll-pct </property> </difference> </min> </max> </product>
            </sum> </product>
          <product> <value> -0.1119 </value>
            <max> <value> 0 </value> <min> <value> 67 </value> <difference> <property> fcs/uh60/airspeed-kt </property> <value> 80 </value> </difference> </min> </max> </product>
        </sum> </function>
      </fcs_function>
      <second_order_filter name="fcs/uh60/stab-servo"> <input> fcs/uh60/stab-cmd-deg </input>
        <c1> 0 </c1> <c2> 0 </c2> <c3> 1 </c3> <c4> 0.0254 </c4> <c5> 0.223 </c5> <c6> 1 </c6> </second_order_filter>
      <actuator name="fcs/uh60/stab-deg"> <input> fcs/uh60/stab-servo </input>
        <rate_limit> 7 </rate_limit> <clipto> <min> -8 </min> <max> 39 </max> </clipto> </actuator>
      <fcs_function name="fcs/uh60/stab-rad"> <function> <toradians> <property> fcs/uh60/stab-deg </property> </toradians> </function>
        <output> fcs/elevator-pos-rad </output> <!-- the platform reports it (VehicleState::elevatorRad); the model's stabilator follows -->
      </fcs_function>
    </channel>
    <channel name="swashplate">
      <fcs_function name="fcs/uh60/long-mixed"> <function> <sum> <property> fcs/uh60/long-in </property> <property> fcs/uh60/pba-in </property> <product> <value> 0.164 </value> <property> fcs/uh60/coll-in </property> </product> <product> <value> 0.5746 </value> <property> fcs/uh60/pedal-in </property> </product> <product> <value> 0.88 </value> <property> velocities/p-rad_sec </property> </product> </sum> </function> </fcs_function>
      <fcs_function name="fcs/uh60/lat-mixed"> <function> <sum> <property> fcs/uh60/lat-in </property> <product> <value> -0.16 </value> <property> fcs/uh60/coll-in </property> </product> <product> <value> 1.3 </value> <property> velocities/q-rad_sec </property> </product> </sum> </function> </fcs_function>
      <fcs_function name="fcs/uh60/pedal-mixed"> <function> <sum> <property> fcs/uh60/pedal-in </property> <product> <value> -0.2889 </value> <property> fcs/uh60/coll-in </property> </product> </sum> </function> </fcs_function>
      <fcs_function name="fcs/uh60/b1c-rad"> <function> <product> <value> 0.04939 </value> <property> fcs/uh60/long-mixed </property> </product> </function> </fcs_function>
      <fcs_function name="fcs/uh60/a1c-rad"> <function> <product> <value> 0.02792 </value> <property> fcs/uh60/lat-mixed </property> </product> </function> </fcs_function>
      <lag_filter name="fcs/uh60/b1s-lag"> <input> fcs/uh60/b1c-rad </input> <c1> 13.888889 </c1> </lag_filter>
      <lag_filter name="fcs/uh60/a1s-lag"> <input> fcs/uh60/a1c-rad </input> <c1> 13.888889 </c1> </lag_filter>
      <fcs_function name="fcs/uh60/b1s-rad">
        <function> <sum> <property> fcs/uh60/b1s-lag </property> <value> 0 </value> </sum> </function>
        <output> propulsion/engine[0]/longitudinal-ctrl-rad </output>
      </fcs_function>
      <fcs_function name="fcs/uh60/a1s-rad">
        <function> <sum> <property> fcs/uh60/a1s-lag </property> <value> 0 </value> </sum> </function>
        <output> propulsion/engine[0]/lateral-ctrl-rad </output>
      </fcs_function>
      <fcs_function name="fcs/uh60/theta0-root-rad">
        <function> <sum> <value> 0.2286 </value> <product> <value> 0.02792 </value> <property> fcs/uh60/coll-in </property> </product> </sum> </function>
        <output> propulsion/engine[0]/collective-ctrl-rad </output>
      </fcs_function>
      <fcs_function name="fcs/uh60/theta-tr-rad">
        <function> <sum> <value> 0.1743 </value> <product> <value> -0.07734 </value> <property> fcs/uh60/pedal-mixed </property> </product> </sum> </function>
        <output> propulsion/engine[1]/antitorque-ctrl-rad </output>
      </fcs_function>
    </channel>
    <channel name="engine">
      <!-- The rotor speed is a state here: the engine's power less the rotors' drives it through the
           drive's inertia; a governor holds the design's rpm, the load fed forward. 'armed' is 0 on
           the first frame after a load or a reset, 1 after: JSBSim resets the components' states but
           not their output properties, nor the rotors' torques, so what the channel reads from the
           previous frame is gated by it then. -->
      <fcs_function name="fcs/uh60/one"> <function> <value> 1 </value> </function> </fcs_function>
      <lag_filter name="fcs/uh60/armed-lag"> <input> fcs/uh60/one </input> <c1> 1000 </c1> </lag_filter>
      <fcs_function name="fcs/uh60/armed"> <function> <gt> <property> fcs/uh60/armed-lag </property> <value> 0.5 </value> </gt> </function> </fcs_function>
      <fcs_function name="fcs/uh60/delta-omega-prev">
        <function> <product> <property> fcs/uh60/armed </property> <property> fcs/uh60/delta-omega </property> </product> </function>
      </fcs_function>
      <fcs_function name="fcs/uh60/omega">
        <function> <sum> <value> 26.999894 </value> <property> fcs/uh60/delta-omega-prev </property> </sum> </function>
      </fcs_function>
      <fcs_function name="fcs/uh60/rpm-error"> <function> <product> <value> -1 </value> <property> fcs/uh60/delta-omega-prev </property> </product> </function> </fcs_function>
      <pid name="fcs/uh60/governor"> <input> fcs/uh60/rpm-error </input>
        <kp> 1.2376 </kp> <ki> 1.547 </ki> <kd> 0.3094 </kd>
        <trigger> fcs/uh60/power-saturated </trigger> </pid>
      <lag_filter name="fcs/uh60/governor-power"> <input> fcs/uh60/governor </input> <c1> 0.8 </c1> </lag_filter>
      <fcs_function name="fcs/uh60/load-power">
        <function> <quotient> <product> <property> fcs/uh60/armed </property> <property> fcs/uh60/omega </property> <sum>
          <property> propulsion/engine[0]/torque-lbsft </property>
          <product> <property> propulsion/engine[1]/torque-lbsft </property> <value> 4.6154443 </value> </product>
        </sum> </product> <value> 1555400 </value> </quotient> </function>
      </fcs_function>
      <fcs_function name="fcs/uh60/power-demand">
        <function> <sum> <property> fcs/uh60/load-power </property> <property> fcs/uh60/governor-power </property> </sum> </function>
      </fcs_function>
      <fcs_function name="fcs/uh60/power">
        <function> <max> <value> 0 </value> <min> <value> 1 </value> <property> fcs/uh60/power-demand </property> </min> </max> </function>
        <output> fcs/throttle-pos-norm[0] </output>
      </fcs_function>
      <fcs_function name="fcs/uh60/power-saturated">
        <function> <gt> <abs> <difference> <property> fcs/uh60/power-demand </property> <property> fcs/uh60/power </property> </difference> </abs> <value> 1e-9 </value> </gt> </function>
      </fcs_function>
      <pure_gain name="fcs/uh60/tail-drive-throttle"> <input> fcs/uh60/power </input> <gain> 0 </gain>
        <output> fcs/throttle-pos-norm[1] </output> </pure_gain>
      <fcs_function name="fcs/uh60/net-torque">
        <function> <product> <property> fcs/uh60/armed </property> <difference>
          <quotient> <product> <property> fcs/uh60/power </property> <value> 1555400 </value> </product>
            <max> <value> 1 </value> <property> fcs/uh60/omega </property> </max> </quotient>
          <sum> <property> propulsion/engine[0]/torque-lbsft </property>
            <product> <property> propulsion/engine[1]/torque-lbsft </property> <value> 4.6154443 </value> </product> </sum>
        </difference> </product> </function>
      </fcs_function>
      <pid name="fcs/uh60/delta-omega"> <input> fcs/uh60/net-torque </input>
        <kp> 0 </kp> <ki type="trap"> 0.00014681292 </ki> <kd> 0 </kd> </pid>
      <fcs_function name="fcs/uh60/rotor-rpm">
        <function> <product> <sum> <value> 26.999894 </value> <property> fcs/uh60/delta-omega </property> </sum> <value> 9.5492966 </value> </product> </function>
        <output> propulsion/engine[0]/x-rpm-dict </output>
      </fcs_function>
    </channel>
  </flight_control>
  <aerodynamics>
    <!-- the main rotor's wake: its skew angle chi from the vertical, tan chi = mu / -lambda -->
    <function name="aero/uh60/wake-tan-chi">
      <quotient> <property> propulsion/engine[0]/advance-ratio </property>
        <max> <value> 0.002 </value> <abs> <property> propulsion/engine[0]/inflow-ratio </property> </abs> </max> </quotient>
    </function>
    <function name="aero/uh60/wake-fus">
      <description> fus: 0.4 ft aft of the hub, 6.8 ft below it </description>
      <product>
        <max> <value> 0 </value> <min> <value> 1 </value>
          <quotient> <difference> <sum> <value> 26.83 </value> <product> <value> 6.75 </value> <property> aero/uh60/wake-tan-chi </property> </product> </sum> <value> 0.3583333333333343 </value> </difference> <value> 2 </value> </quotient> </min> </max>
        <max> <value> 0 </value> <min> <value> 1 </value>
          <quotient> <difference> <value> 0.3583333333333343 </value> <difference> <product> <value> 6.75 </value> <property> aero/uh60/wake-tan-chi </property> </product> <value> 26.83 </value> </difference> </difference> <value> 2 </value> </quotient> </min> </max>
      </product>
    </function>
    <function name="aero/uh60/wake-hs">
