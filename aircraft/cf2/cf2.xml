        <sum> <product> <value> 5.3388408e-10 </value> <pow> <property> fcs/cf2/omega[0] </property> <value> 2 </value> </pow> </product> <product> <value> -5.3388408e-10 </value> <pow> <property> fcs/cf2/omega[1] </property> <value> 2 </value> </pow> </product> <product> <value> 5.3388408e-10 </value> <pow> <property> fcs/cf2/omega[2] </property> <value> 2 </value> </pow> </product> <product> <value> -5.3388408e-10 </value> <pow> <property> fcs/cf2/omega[3] </property> <value> 2 </value> </pow> </product> </sum>
      </function>
    </axis>
    <function name="aero/cf2/rotor-speed-sum"> <sum> <property> fcs/cf2/omega[0] </property> <property> fcs/cf2/omega[1] </property> <property> fcs/cf2/omega[2] </property> <property> fcs/cf2/omega[3] </property> </sum> </function>
    <axis name="X"> <function name="aero/force/cf2-rotor-drag-x"> <product> <value> -6.2892697e-08 </value> <property> aero/cf2/rotor-speed-sum </property> <property> velocities/u-aero-fps </property> </product> </function> </axis>
    <axis name="Y"> <function name="aero/force/cf2-rotor-drag-y"> <product> <value> -6.2892697e-08 </value> <property> aero/cf2/rotor-speed-sum </property> <property> velocities/v-aero-fps </property> </product> </function> </axis>
    <axis name="Z"> <function name="aero/force/cf2-rotor-drag-z"> <product> <value> -7.0652787e-08 </value> <property> aero/cf2/rotor-speed-sum </property> <property> velocities/w-aero-fps </property> </product> </function> </axis>
    <function name="aero/cf2/ground-effect-scale">
      <description> k_ge (r / 4)^2 / h^2, h the rotors' height above the ground (m) </description>
      <quotient> <value> 2.4621475e-12 </value> <pow> <max> <value> 0.037763713 </value>
        <sum> <product> <property> position/h-agl-ft </property> <value> 0.3048 </value> </product> <value> 0 </value> </sum> </max> <value> 2 </value> </pow> </quotient>
    </function>
    <axis name="Z"> <function name="aero/force/cf2-ground-effect">
      <product> <value> -1 </value> <property> aero/cf2/ground-effect-scale </property>
        <sum> <pow> <property> fcs/cf2/omega[0] </property> <value> 2 </value> </pow> <pow> <property> fcs/cf2/omega[1] </property> <value> 2 </value> </pow> <pow> <property> fcs/cf2/omega[2] </property> <value> 2 </value> </pow> <pow> <property> fcs/cf2/omega[3] </property> <value> 2 </value> </pow> </sum> </product> </function> </axis>
  </aerodynamics>
