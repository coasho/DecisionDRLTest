# Runs the crasher with a fresh dump directory and checks that a minidump appeared.
file(REMOVE_RECURSE "${DIR}")
file(MAKE_DIRECTORY "${DIR}")
execute_process(COMMAND "${EXE}" "${DIR}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
message(STATUS "crasher exit ${rc}; stderr: ${err}")
if(rc EQUAL 0)
    message(FATAL_ERROR "the crasher did not crash")
endif()
file(GLOB dumps "${DIR}/*.dmp")
list(LENGTH dumps n)
if(n EQUAL 0)
    message(FATAL_ERROR "no minidump written in ${DIR}")
endif()
foreach(d ${dumps})
    file(SIZE "${d}" size)
    message(STATUS "minidump ${d}: ${size} bytes")
    if(size LESS 1024)
        message(FATAL_ERROR "minidump too small")
    endif()
endforeach()
