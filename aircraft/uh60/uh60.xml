    <property value="-0.0448501">fsim/hover/elevator_trim</property>
    <property value="0.626234">fsim/hover/heave/damping</property>
    <property value="0.072">fsim/hover/heave/lag_s</property>
    <property value="26.6672">fsim/hover/heave/power</property>
    <property value="7438.91">fsim/hover/mass_kg</property>
    <property value="1.10767">fsim/hover/pitch/damping</property>
    <property value="0.072">fsim/hover/pitch/lag_s</property>
    <property value="-1.72993">fsim/hover/pitch/power</property>
    <property value="4.78471">fsim/hover/pitch_attitude_deg</property>
    <property value="3.32986">fsim/hover/roll/damping</property>
    <property value="0.072">fsim/hover/roll/lag_s</property>
    <property value="6.42879">fsim/hover/roll/power</property>
    <property value="-2.22732">fsim/hover/roll_attitude_deg</property>
    <property value="0.401595">fsim/hover/rudder_trim</property>
    <property value="0.579932">fsim/hover/throttle_trim</property>
    <property value="0.46311">fsim/hover/yaw/damping</property>
    <property value="0.0380055">fsim/hover/yaw/lag_s</property>
    <property value="-1.99907">fsim/hover/yaw/power</property>
